/***********************************************************************
 * project_6_axi_lite_gain_control.c
 *
 * Demonstrates runtime gain control of the axis_gain_scaler v2.0
 * via AXI4-Lite register writes. Runs multiple DMA transfers with
 * different gain values without recompiling hardware.
 *
 * Register Map (base = 0x4001_0000):
 *   +0x00  CTRL   bit[0] = enable
 *   +0x04  GAIN   bits[7:0] = gain multiplier
 *   +0x08  COUNT  bits[31:0] = samples processed (read-only)
 *   +0x0C  STATUS bits[1:0] = {stream_active, enable}
 ***********************************************************************/

#include "xaxidma.h"
#include "xparameters.h"
#include "xil_printf.h"
#include "xil_cache.h"
#include "xil_io.h"
#include <stdint.h>
#include <string.h>

/*--------------------------------------------------------------------
 * Accelerator register base and offsets
 * These come from your Address Editor in Vivado block design
 *--------------------------------------------------------------------*/
#define ACCEL_BASE          0x40000000UL

#define ACCEL_CTRL_OFFSET   0x00
#define ACCEL_GAIN_OFFSET   0x04
#define ACCEL_COUNT_OFFSET  0x08
#define ACCEL_STATUS_OFFSET 0x0C

/* CTRL register bit definitions */
#define CTRL_ENABLE         (1U << 0)

/* Convenience macros for register access */
#define ACCEL_WRITE(offset, val) \
    Xil_Out32(ACCEL_BASE + (offset), (val))

#define ACCEL_READ(offset) \
    Xil_In32(ACCEL_BASE + (offset))

/*--------------------------------------------------------------------
 * DMA and buffer configuration
 *--------------------------------------------------------------------*/
#define DMA_DEV_ID          XPAR_AXIDMA_0_DEVICE_ID
#define TX_BUFFER_BASE      0x00100000UL
#define RX_BUFFER_BASE      0x00200000UL
#define NUM_SAMPLES         64
#define BUFFER_BYTES        (NUM_SAMPLES * sizeof(uint32_t))

static XAxiDma dma_inst;

/*--------------------------------------------------------------------
 * Function prototypes
 *--------------------------------------------------------------------*/
static int  dma_init(void);
static int  run_dma_transfer(uint32_t tx_addr, uint32_t rx_addr,
                             uint32_t len);
static void accel_configure(uint8_t gain);
static void accel_enable(void);
static void accel_disable(void);
static void accel_print_registers(void);
static void fill_tx_ramp(uint32_t *buf, uint32_t count);
static int  validate_results(uint32_t *tx, uint32_t *rx,
                             uint32_t count, uint32_t gain);
static int SetupIntrSystem(INTC *IntcInstancePtr,
			   XAxiDma *AxiDmaPtr, u16 TxIntrId, u16 RxIntrId);

/*====================================================================
 * MAIN
 *====================================================================*/
int main(void)
{
    int status;
    uint32_t *tx_buf = (uint32_t *)TX_BUFFER_BASE;
    uint32_t *rx_buf = (uint32_t *)RX_BUFFER_BASE;

    xil_printf("\r\n");
    xil_printf("=============================================\r\n");
    xil_printf(" Project 6: AXI4-Lite Gain Control          \r\n");
    xil_printf(" Runtime-Configurable Stream Accelerator    \r\n");
    xil_printf("=============================================\r\n\r\n");

    /*------------------------------------------------------------------
     * Step 1: DMA init
     *------------------------------------------------------------------*/
    status = dma_init();
    if (status != XST_SUCCESS) {
        xil_printf("[FAIL] DMA init failed\r\n");
        return XST_FAILURE;
    }
    xil_printf("[OK] DMA initialized\r\n");

    /*------------------------------------------------------------------
     * Step 2: Read initial accelerator register state
     * Useful for verifying AXI-Lite connectivity before doing anything
     *------------------------------------------------------------------*/
    xil_printf("\r\n[INIT] Accelerator register state at reset:\r\n");
    accel_print_registers();

    /*------------------------------------------------------------------
     * Step 3: Fill TX buffer with known ramp pattern
     *------------------------------------------------------------------*/
    fill_tx_ramp(tx_buf, NUM_SAMPLES);
    Xil_DCacheFlushRange((UINTPTR)tx_buf, BUFFER_BYTES);
    Xil_DCacheFlushRange((UINTPTR)rx_buf, BUFFER_BYTES);
    xil_printf("[TX] Buffer filled and cache flushed\r\n");

    /*------------------------------------------------------------------
     * Run multiple transfers with different gain values
     * This demonstrates runtime reconfiguration without re-synthesis
     *------------------------------------------------------------------*/
    uint8_t gain_values[] = {1, 2, 4, 10, 255};
    int num_tests = sizeof(gain_values) / sizeof(gain_values[0]);
    int pass_count = 0;

    for (int t = 0; t < num_tests; t++) {
        uint8_t gain = gain_values[t];

        xil_printf("\r\n-----------------------------------------\r\n");
        xil_printf(" Test %d: gain = %d\r\n", t+1, gain);
        xil_printf("-----------------------------------------\r\n");

        /*--------------------------------------------------------------
         * CORRECT SEQUENCE:
         * 1. Disable accelerator first (safe state)
         * 2. Write new gain register
         * 3. Enable accelerator
         * 4. Start DMA transfer
         *
         * WHY: Writing gain while enabled could cause one sample to
         * be processed with a partial/intermediate gain value if the
         * register write happens mid-transfer. Disable first = safe.
         *--------------------------------------------------------------*/
        accel_disable();
        accel_configure(gain);
        accel_enable();

        xil_printf("[ACCEL] Configured. Register state:\r\n");
        accel_print_registers();

        /* Clear RX buffer and flush */
        memset(rx_buf, 0xAB, BUFFER_BYTES);  /* 0xAB = obvious poison value */
        Xil_DCacheFlushRange((UINTPTR)rx_buf, BUFFER_BYTES);

        /* Run transfer */
        status = run_dma_transfer(TX_BUFFER_BASE, RX_BUFFER_BASE,
                                  BUFFER_BYTES);
        if (status != XST_SUCCESS) {
            xil_printf("[FAIL] DMA transfer failed for gain=%d\r\n", gain);
            continue;
        }

        /* Invalidate and read results */
        Xil_DCacheInvalidateRange((UINTPTR)rx_buf, BUFFER_BYTES);

        /* Read COUNT register — should have incremented by NUM_SAMPLES */
        uint32_t count_after = ACCEL_READ(ACCEL_COUNT_OFFSET);
        xil_printf("[COUNT] Samples processed so far: %lu\r\n",
                   (unsigned long)count_after);

        /* Validate */
        status = validate_results(tx_buf, rx_buf, NUM_SAMPLES, gain);
        if (status == XST_SUCCESS) {
            xil_printf("[PASS] gain=%d correct!\r\n", gain);
            pass_count++;
        } else {
            xil_printf("[FAIL] gain=%d mismatch detected\r\n", gain);
        }
    }

    /*------------------------------------------------------------------
     * Summary
     *------------------------------------------------------------------*/
    xil_printf("\r\n=============================================\r\n");
    xil_printf(" Results: %d / %d tests passed\r\n",
               pass_count, num_tests);
    if (pass_count == num_tests) {
        xil_printf(" ALL TESTS PASSED\r\n");
    } else {
        xil_printf(" SOME TESTS FAILED — check debug output\r\n");
    }
    xil_printf("=============================================\r\n");

    /* Final register dump — COUNT should show total samples processed */
    xil_printf("\r\n[FINAL] Accelerator register state:\r\n");
    accel_print_registers();

    accel_disable();
    return (pass_count == num_tests) ? XST_SUCCESS : XST_FAILURE;
}

/*====================================================================
 * Accelerator register access functions
 *====================================================================*/

static void accel_configure(uint8_t gain)
{
    /* Write gain value — only bits[7:0] used, upper bits ignored by HW */
    ACCEL_WRITE(ACCEL_GAIN_OFFSET, (uint32_t)gain);
    xil_printf("[ACCEL] GAIN register written: %d (0x%02X)\r\n",
               gain, gain);
}

static void accel_enable(void)
{
    uint32_t ctrl = ACCEL_READ(ACCEL_CTRL_OFFSET);
    ctrl |= CTRL_ENABLE;
    ACCEL_WRITE(ACCEL_CTRL_OFFSET, ctrl);
    xil_printf("[ACCEL] Enabled (CTRL=0x%08X)\r\n", (unsigned int)ctrl);
}

static void accel_disable(void)
{
    uint32_t ctrl = ACCEL_READ(ACCEL_CTRL_OFFSET);
    ctrl &= ~CTRL_ENABLE;
    ACCEL_WRITE(ACCEL_CTRL_OFFSET, ctrl);
}

static void accel_print_registers(void)
{
    uint32_t ctrl   = ACCEL_READ(ACCEL_CTRL_OFFSET);
    uint32_t gain   = ACCEL_READ(ACCEL_GAIN_OFFSET);
    uint32_t count  = ACCEL_READ(ACCEL_COUNT_OFFSET);
    uint32_t status = ACCEL_READ(ACCEL_STATUS_OFFSET);

    /* %08X matches (unsigned int) — both 32-bit, no mismatch */
    xil_printf("  CTRL   (0x00) = 0x%08X  [enable=%d]\r\n",
               (unsigned int)ctrl,
               (int)(ctrl & 1));

    xil_printf("  GAIN   (0x04) = 0x%08X  [gain=%u]\r\n",
               (unsigned int)gain,
               (unsigned int)(gain & 0xFF));

    xil_printf("  COUNT  (0x08) = 0x%08X  [%u samples]\r\n",
               (unsigned int)count,
               (unsigned int)count);

    xil_printf("  STATUS (0x0C) = 0x%08X  [active=%d, enabled=%d]\r\n",
               (unsigned int)status,
               (int)((status >> 1) & 1),
               (int)(status & 1));
}

/*====================================================================
 * DMA functions (same pattern as Project 5)
 *====================================================================*/

static int dma_init(void)
{
    XAxiDma_Config *cfg = XAxiDma_LookupConfig(DMA_DEV_ID);
    if (!cfg) return XST_FAILURE;

    int status = XAxiDma_CfgInitialize(&dma_inst, cfg);
    if (status != XST_SUCCESS) return XST_FAILURE;

    if (XAxiDma_HasSg(&dma_inst)) {
        xil_printf("[ERR] Expected simple DMA mode\r\n");
        return XST_FAILURE;
    }

    XAxiDma_IntrEnable(&dma_inst, XAXIDMA_IRQ_ALL_MASK,
                        XAXIDMA_DEVICE_TO_DMA);
    XAxiDma_IntrEnable(&dma_inst, XAXIDMA_IRQ_ALL_MASK,
                        XAXIDMA_DMA_TO_DEVICE);
    return XST_SUCCESS;
}

static int run_dma_transfer(uint32_t tx_addr, uint32_t rx_addr,
                            uint32_t len)
{
    /* Always arm S2MM before MM2S */
    int status = XAxiDma_SimpleTransfer(&dma_inst, (UINTPTR)rx_addr,
                                        len, XAXIDMA_DEVICE_TO_DMA);
    if (status != XST_SUCCESS) return XST_FAILURE;

    status = XAxiDma_SimpleTransfer(&dma_inst, (UINTPTR)tx_addr,
                                    len, XAXIDMA_DMA_TO_DEVICE);
    if (status != XST_SUCCESS) return XST_FAILURE;

    /* Poll both channels with timeout */
    uint32_t timeout;

    timeout = 2000000;
    while (XAxiDma_Busy(&dma_inst, XAXIDMA_DMA_TO_DEVICE))
        if (timeout - 1 == 0) {
        	xil_printf("[ERR] MM2S timeout\r\n");
            return XST_FAILURE;
        }

    timeout = 2000000;
    while (XAxiDma_Busy(&dma_inst, XAXIDMA_DEVICE_TO_DMA))
        if (timeout - 1 == 0) {
        	xil_printf("[ERR] S2MM timeout\r\n");
            return XST_FAILURE;
        }

    return XST_SUCCESS;
}

/*====================================================================
 * Buffer utilities
 *====================================================================*/

static void fill_tx_ramp(uint32_t *buf, uint32_t count)
{
    for (uint32_t i = 0; i < count; i++)
        buf[i] = i;  /* 0, 1, 2, 3, ... */
}

static int validate_results(uint32_t *tx, uint32_t *rx,
                            uint32_t count, uint32_t gain)
{
    int errors = 0;
    for (uint32_t i = 0; i < count; i++) {
        uint32_t expected = tx[i] * gain;
        if (rx[i] != expected) {
            xil_printf("  [%3d] TX=%-6lu Expected=%-10lu Got=%lu\r\n",
                       i, (unsigned long)tx[i],
                       (unsigned long)expected,
                       (unsigned long)rx[i]);
            if (++errors >= 5) {
                xil_printf("  ... (stopping after 5 errors)\r\n");
                break;
            }
        }
    }
    return (errors == 0) ? XST_SUCCESS : XST_FAILURE;
}

/*****************************************************************************/
/*
*
* This function setups the interrupt system so interrupts can occur for the
* DMA, it assumes INTC component exists in the hardware system.
*
* @param	IntcInstancePtr is a pointer to the instance of the INTC.
* @param	AxiDmaPtr is a pointer to the instance of the DMA engine
* @param	TxIntrId is the TX channel Interrupt ID.
* @param	RxIntrId is the RX channel Interrupt ID.
*
* @return
*		- XST_SUCCESS if successful,
*		- XST_FAILURE.if not successful
*
* @note		None.
*
******************************************************************************/
static int SetupIntrSystem(INTC *IntcInstancePtr, XAxiDma *AxiDmaPtr, u16 TxIntrId, u16 RxIntrId)
{
	int Status;

#ifdef XPAR_INTC_0_DEVICE_ID

	/* Initialize the interrupt controller and connect the ISRs */
	Status = XIntc_Initialize(IntcInstancePtr, INTC_DEVICE_ID);
	if (Status != XST_SUCCESS) {

		xil_printf("Failed init intc\r\n");
		return XST_FAILURE;
	}

	Status = XIntc_Connect(IntcInstancePtr, TxIntrId,
			       (XInterruptHandler) TxIntrHandler, AxiDmaPtr);
	if (Status != XST_SUCCESS) {

		xil_printf("Failed tx connect intc\r\n");
		return XST_FAILURE;
	}

	Status = XIntc_Connect(IntcInstancePtr, RxIntrId,
			       (XInterruptHandler) RxIntrHandler, AxiDmaPtr);
	if (Status != XST_SUCCESS) {

		xil_printf("Failed rx connect intc\r\n");
		return XST_FAILURE;
	}

	/* Start the interrupt controller */
	Status = XIntc_Start(IntcInstancePtr, XIN_REAL_MODE);
	if (Status != XST_SUCCESS) {

		xil_printf("Failed to start intc\r\n");
		return XST_FAILURE;
	}

	XIntc_Enable(IntcInstancePtr, TxIntrId);
	XIntc_Enable(IntcInstancePtr, RxIntrId);

#else

	XScuGic_Config *IntcConfig;


	/*
	 * Initialize the interrupt controller driver so that it is ready to
	 * use.
	 */
	IntcConfig = XScuGic_LookupConfig(INTC_DEVICE_ID);
	if (NULL == IntcConfig) {
		return XST_FAILURE;
	}

	Status = XScuGic_CfgInitialize(IntcInstancePtr, IntcConfig,
				       IntcConfig->CpuBaseAddress);
	if (Status != XST_SUCCESS) {
		return XST_FAILURE;
	}


	XScuGic_SetPriorityTriggerType(IntcInstancePtr, TxIntrId, 0xA0, 0x3);

	XScuGic_SetPriorityTriggerType(IntcInstancePtr, RxIntrId, 0xA0, 0x3);
	/*
	 * Connect the device driver handler that will be called when an
	 * interrupt for the device occurs, the handler defined above performs
	 * the specific interrupt processing for the device.
	 */
	Status = XScuGic_Connect(IntcInstancePtr, TxIntrId,
				 (Xil_InterruptHandler)TxIntrHandler,
				 AxiDmaPtr);
	if (Status != XST_SUCCESS) {
		return Status;
	}

	Status = XScuGic_Connect(IntcInstancePtr, RxIntrId,
				 (Xil_InterruptHandler)RxIntrHandler,
				 AxiDmaPtr);
	if (Status != XST_SUCCESS) {
		return Status;
	}

	XScuGic_Enable(IntcInstancePtr, TxIntrId);
	XScuGic_Enable(IntcInstancePtr, RxIntrId);


#endif

	/* Enable interrupts from the hardware */

	Xil_ExceptionInit();
	Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT,
				     (Xil_ExceptionHandler)INTC_HANDLER,
				     (void *)IntcInstancePtr);

	Xil_ExceptionEnable();

	return XST_SUCCESS;
}
